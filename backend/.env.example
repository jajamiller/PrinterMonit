DEBUG=False
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/printer_monitor
SECRET_KEY=replace-with-a-random-secret-before-deployment
ACCESS_TOKEN_EXPIRE_MINUTES=10080
SNMP_TIMEOUT_SECONDS=3
SNMP_RETRIES=2
SNMP_POLL_INTERVAL_MINUTES=60
SNMP_COMMUNITY=public
REPORTS_DIR=/tmp/printer_reports
AUTO_CREATE_TABLES=true
BOOTSTRAP_ADMIN=true
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=admin
